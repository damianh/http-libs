<Project>
  <PropertyGroup>
    <!-- Tooling, samples and docs build on the newest runtime. -->
    <TargetFramework>net11.0</TargetFramework>
    <!-- Shipped libraries and their tests opt in with <TargetFramework /> + <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>. -->
    <LibraryTargetFrameworks>net10.0;net11.0</LibraryTargetFrameworks>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
