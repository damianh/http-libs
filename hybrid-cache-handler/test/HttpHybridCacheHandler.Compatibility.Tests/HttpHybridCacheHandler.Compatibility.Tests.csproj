<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <TargetFrameworks Condition="'$(CompatibilityTargetFramework)' == 'netstandard2.0'">net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>HttpHybridCacheHandler.Compatibility.Tests</AssemblyName>
    <RootNamespace>DamianH.HttpHybridCacheHandler.Compatibility.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DefineConstants Condition="'$(CompatibilityTargetFramework)' == 'netstandard2.0'">$(DefineConstants);STANDARD_ASSETS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3.core.mtp-v2" Version="3.2.2" />
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\HttpHybridCacheHandler.Tests\CompatibilityPrimitiveTests.cs" Link="CompatibilityPrimitiveTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompatibilityTargetFramework)' == 'netstandard2.0'">
    <!-- The host restores as net10.0; include the forwarding assemblies required by forced legacy binaries. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler\HttpHybridCacheHandler.csproj" />
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler.ContentStore\HttpHybridCacheHandler.ContentStore.csproj" />
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler.ContentStore.AzureBlob\HttpHybridCacheHandler.ContentStore.AzureBlob.csproj" />
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler.ContentStore.S3\HttpHybridCacheHandler.ContentStore.S3.csproj" />
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler.ContentStore.GoogleCloudStorage\HttpHybridCacheHandler.ContentStore.GoogleCloudStorage.csproj" />
    <ProjectReference Include="..\..\src\HttpHybridCacheHandler.ContentStore.FileSystem\HttpHybridCacheHandler.ContentStore.FileSystem.csproj" />
    <ProjectReference Update="@(ProjectReference)" Condition="'$(CompatibilityTargetFramework)' == 'netstandard2.0'"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      AdditionalProperties="TargetFramework=netstandard2.0"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="ValidateCompatibilityTarget" BeforeTargets="PrepareForBuild"
          Condition="'$(CompatibilityTargetFramework)' != '' And '$(CompatibilityTargetFramework)' != 'netstandard2.0'">
    <Error Text="CompatibilityTargetFramework must be empty or netstandard2.0." />
  </Target>
</Project>
