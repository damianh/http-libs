<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);CONFORMANCE_STANDARD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- The net10 host needs the forwarding assemblies referenced by the forced legacy binaries. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="10.0.10" />
    <ProjectReference Include="..\..\src\HybridCacheHandler\HybridCacheHandler.csproj" />
    <ProjectReference Include="..\..\src\HybridCacheHandler.ContentStore\HybridCacheHandler.ContentStore.csproj" />
    <ProjectReference Include="..\..\src\HybridCacheHandler.ContentStore.FileSystem\HybridCacheHandler.ContentStore.FileSystem.csproj" />
    <ProjectReference Update="@(ProjectReference)"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      AdditionalProperties="TargetFramework=netstandard2.0"
                      SkipGetTargetFrameworkProperties="true" />
    <Compile Include="..\ConformanceProxy\*.cs" Link="Proxy\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
