<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <AssemblyName>DamianH.Http.ForwardedHeaders</AssemblyName>
    <RootNamespace>DamianH.Http.ForwardedHeaders</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>fwd-v</MinVerTagPrefix>
    <PackageId>DamianH.Http.ForwardedHeaders</PackageId>
    <Authors>Damian Hickey</Authors>
    <Description>RFC 7239 Forwarded header parsing and trusted-proxy middleware for ASP.NET Core.</Description>
    <PackageTags>http;aspnetcore;forwarded;rfc7239;proxy;middleware</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/damianh/http-libs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/damianh/http-libs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Http.ForwardedHeaders.Tests" />
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
